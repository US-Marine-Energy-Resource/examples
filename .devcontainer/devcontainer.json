{
  "name": "us-marine-energy-resource examples",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "1.9.36",
      "installTinyTex": false
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "containerEnv": {
    "MER_WAVE_CACHE_DIR": "/workspaces/.mer_wave_cache"
  },
  "postCreateCommand": "pipx install uv && make sync && make check-toolchain",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "quarto.quarto",
        "charliermarsh.ruff",
        "adamraichu.pdf-viewer"
      ],
      "settings": {
        "quarto.render.previewType": "internal",
        "quarto.render.previewReveal": true,
        "quarto.render.renderOnSave": false,
        "workbench.startupEditor": "none"
      }
    },
    "codespaces": {
      "openFiles": [
        "us_doe_h2o_wave_hindcast_resource_characterization.qmd",
        "us_doe_h2o_wave_hindcast_resource_characterization.ipynb",
        "us_doe_h2o_wave_hindcast_resource_characterization.pdf",
        "README.md"
      ]
    }
  }
}
